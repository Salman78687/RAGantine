GROQ_API_KEY=<REDACTED>
OPENAI_API_KEY=<REDACTED>
GEMINI_API_KEY=<REDACTED>        # free key from aistudio.google.com
OPENSEARCH_URL=http://localhost:9200
LANGFUSE_PUBLIC_KEY=            # optional
LANGFUSE_SECRET_KEY=            # optional
LANGFUSE_HOST=https://cloud.langfuse.com
RAGANTINE_API_KEY=               # optional; required to serve on a non-loopback host
RAGANTINE_ASK_RATE_PER_MIN=30   # per-client /ask limit, 0 = off
HF_TOKEN=                       # optional, for pushing the dataset
RAGANTINE_CONFIG=configs/default.yaml
RAGANTINE_MODELS_CONFIG=configs/models.yaml
